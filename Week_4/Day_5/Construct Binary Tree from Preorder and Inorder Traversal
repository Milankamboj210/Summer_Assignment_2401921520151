class Solution {
    public TreeNode buildTree(int[] preorder, int[] inorder) {
       HashMap<Integer ,Integer> map = new HashMap<>();
       for(int i = 0 ; i<inorder.length;i++){
          map.put(inorder[i],i);
       } 
       TreeNode root = buildtree(preorder,inorder,0,preorder.length-1,0,inorder.length-1 , map);
       return root;
    }
    TreeNode buildtree(int[] preorder , int [] inorder , int prestart , int preend , int instart , int inend , HashMap<Integer ,Integer> map){
        if(prestart>preend || instart>inend){
            return null;
        }
        TreeNode root = new TreeNode(preorder[prestart]);
        int inroot = map.get(root.val);
        int lefted = inroot - instart;
        root.left = buildtree(preorder , inorder , prestart+1 , prestart+lefted, instart , inroot-1,map);
        root.right = buildtree(preorder , inorder , prestart+lefted +1, preend , inroot+1, inend,map);
        return root;
    }
}
