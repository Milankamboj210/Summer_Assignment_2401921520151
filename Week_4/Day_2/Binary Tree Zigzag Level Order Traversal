class Solution {
    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {
        List<List<Integer>> list = new ArrayList<>();
        if (root == null) {
            return list;
        }
        Queue<TreeNode> q = new LinkedList<>();
        q.add(root);
        boolean flag = false;
        while (!q.isEmpty()) {
            int size = q.size();
            List<Integer> ds = new ArrayList<>();
            for (int i = 0; i < size; i++) {
                TreeNode node = q.remove();
                ds.add(node.val);
                if (node.left != null) {
                    q.add(node.left);
                }
                if (node.right != null) {
                    q.add(node.right);
                }
            }
            if (flag) {
                int k = 0;
                int l = ds.size() - 1;
                while (k < l) {
                    int temp = ds.get(k);
                    ds.set(k, ds.get(l));
                    ds.set(l, temp);
                    k++;
                    l--;
                }
            }
            list.add(ds);
            flag = !flag;
        }
        return list;
    }
}
