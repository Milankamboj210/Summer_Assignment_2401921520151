class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
    List<Integer> in = new ArrayList<>();
    inorder(root , in);
    return in;
    }
     public void inorder (TreeNode root , List<Integer> in){
        if(root==null){
            return;
        }
        inorder(root.left , in);
        in.add(root.val);
        inorder(root.right ,in);
 }
    }
