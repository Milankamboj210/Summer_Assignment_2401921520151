class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) { 
       int [] arr = new int[nums1.length];
         for(int i = 0;i<nums1.length;i++){
            int max = nums1[i];
            for(int j = nums2.length-1;j>=0;j--){
                 if(nums2[j]>nums1[i]){
                    max = nums2[j];
                 }
                 if(nums2[j]==nums1[i]){
                    break;
                 }
            }
            if(max==nums1[i]){
                arr[i] = -1;
            }else{
            arr[i] = max;
            }
         }
         return arr;
    }
}
