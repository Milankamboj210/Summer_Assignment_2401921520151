class Solution {
    public int maxArea(int[] height) {
        int l =0,max=0;
        int r = height.length-1;
        while(l<r){
            int area = (r-l)*(Math.min(height[l],height[r]));
            if(area>max){
                max = Math.max(max,area);
            } if(height[l]>height[r]){
                r--;
            }else{
                l++;
            }
        } return max;
    } 
}
