class Solution {
    public double findMaxAverage(int[] nums, int k) {
      int i = 0 ;
      int j = k;
      double sum = 0;
      for(int x = 0 ;x<k ;x++){
        sum+=nums[x];
      }
      double max = sum;
      while(j<nums.length){
       sum = sum - nums[i] + nums[j];
       max = Math.max(sum,max);
       i++;
       j++;
      }  
      return max/k;
    }
}
